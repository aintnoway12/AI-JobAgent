<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <!-- 섹션 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="6dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="공공기관 채용 정보"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#1E293B" />

    </LinearLayout>

    <!-- 근무지 필터 -->
    <!-- NOTICE : 수정 - 지역 코드 및 필터 항목은 guide.md 참조, 변경 가능 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="근무지"
            android:textSize="13sp"
            android:textColor="#64748B"
            android:layout_marginEnd="8dp" />

        <Spinner
            android:id="@+id/spinnerLocation"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_spinner"
            android:paddingHorizontal="8dp" />

        <Button
            android:id="@+id/btnSearch"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:text="검색"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#5D5FEF"
            android:paddingHorizontal="14dp"
            style="?attr/materialButtonStyle" />

    </LinearLayout>

    <!-- 로딩 -->
    <ProgressBar
        android:id="@+id/recruitProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="8dp"
        android:visibility="gone" />

    <!-- 빈 상태 -->
    <TextView
        android:id="@+id/tvRecruitEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="16dp"
        android:text="검색 결과가 없습니다."
        android:textSize="14sp"
        android:textColor="#94A3B8"
        android:visibility="gone" />

    <!-- 채용 목록 RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRecruits"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        android:paddingBottom="4dp"
        android:visibility="gone" />

    <!-- 구분선 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:background="#E2E8F0" />

    <!-- 채용 달력 헤더 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="6dp"
        android:text="채용 달력"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#1E293B" />

    <!-- JobKorea 채용 달력 WebView -->
    <!-- NOTICE : 수정 - 달력 URL 및 높이 조정 가능 -->
    <WebView
        android:id="@+id/webViewCalendar"
        android:layout_width="match_parent"
        android:layout_height="800dp"
        android:scrollbars="none" />

</LinearLayout>
