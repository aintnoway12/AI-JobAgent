<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:id="@+id/layoutLanding"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="visible">

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_launcher_foreground"
            android:background="#F8FAFC"
            android:padding="16dp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JobCoach AI"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#1E293B"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI 기반 맞춤형 취업 코칭 플랫폼"
            android:textSize="14sp"
            android:textColor="#64748B"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="48dp"/>

        <Button
            android:id="@+id/btnGoToLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="로그인하기"
            android:backgroundTint="#5D5FEF"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnGoToRegister"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="이메일로 회원가입"
            app:strokeColor="#5D5FEF"
            android:textColor="#5D5FEF"
            android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutLogin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView android:layout_width="80dp" android:layout_height="80dp" android:src="@drawable/ic_launcher_foreground" android:background="#F8FAFC" android:layout_marginBottom="20dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="JobCoach AI" android:textSize="28sp" android:textStyle="bold" android:textColor="#1E293B"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔑 서비스를 이용하기 위해 로그인을 진행합니다." android:textSize="13sp" android:textColor="#5D5FEF" android:layout_marginTop="8dp" android:layout_marginBottom="32dp"/>

        <EditText android:id="@+id/etLoginEmail" android:layout_width="match_parent" android:layout_height="50dp" android:hint="아이디(이메일)" android:padding="12dp" android:layout_marginBottom="12dp" android:inputType="textEmailAddress" android:background="@android:drawable/editbox_background_normal"/>
        <EditText android:id="@+id/etLoginPw" android:layout_width="match_parent" android:layout_height="50dp" android:hint="비밀번호" android:padding="12dp" android:layout_marginBottom="24dp" android:inputType="textPassword" android:background="@android:drawable/editbox_background_normal"/>

        <Button android:id="@+id/btnLoginDone" android:layout_width="match_parent" android:layout_height="56dp" android:text="로그인 완료" android:backgroundTint="#5D5FEF" android:textColor="#FFFFFF" android:layout_marginBottom="16dp"/>
        <TextView android:id="@+id/btnBackFromLogin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="← 처음으로 돌아가기" android:textColor="#94A3B8" android:textSize="13sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutRegister"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView android:layout_width="80dp" android:layout_height="80dp" android:src="@drawable/ic_launcher_foreground" android:background="#F8FAFC" android:layout_marginBottom="20dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="JobCoach AI" android:textSize="28sp" android:textStyle="bold" android:textColor="#1E293B"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📝 간편 회원가입으로 나만의 AI 코칭을 시작하세요." android:textSize="13sp" android:textColor="#5D5FEF" android:layout_marginTop="8dp" android:layout_marginBottom="32dp"/>

        <EditText android:id="@+id/etRegEmail" android:layout_width="match_parent" android:layout_height="50dp" android:hint="이메일 주소" android:padding="12dp" android:layout_marginBottom="12dp" android:inputType="textEmailAddress" android:background="@android:drawable/editbox_background_normal"/>

        <!-- Name Field -->
        <EditText android:id="@+id/etRegName" android:layout_width="match_parent" android:layout_height="50dp" android:hint="이름" android:padding="12dp" android:layout_marginBottom="12dp" android:inputType="textPersonName" android:background="@android:drawable/editbox_background_normal"/>

        <EditText android:id="@+id/etRegPw" android:layout_width="match_parent" android:layout_height="50dp" android:hint="비밀번호" android:padding="12dp" android:layout_marginBottom="24dp" android:inputType="textPassword" android:background="@android:drawable/editbox_background_normal"/>

        <Button android:id="@+id/btnRegDone" android:layout_width="match_parent" android:layout_height="56dp" android:text="회원가입 완료" android:backgroundTint="#5D5FEF" android:textColor="#FFFFFF" android:layout_marginBottom="16dp"/>
        <TextView android:id="@+id/btnBackFromReg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="← 처음으로 돌아가기" android:textColor="#94A3B8" android:textSize="13sp"/>
    </LinearLayout>

</FrameLayout>